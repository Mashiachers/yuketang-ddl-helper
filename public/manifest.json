{
  "manifest_version": 3,
  "name": "雨课堂 DDL 助手",
  "description": "纯本地运行的雨课堂全课程 DDL 聚合与课程资源导出助手，支持多级提醒日历 (.ics)、课程知识库/NotebookLM/AI Context Pack 导出与结构化 Prompt 打包。",
  "version": "0.2.0",
  "version_name": "0.2.0-beta",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.yuketang.cn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "雨课堂 DDL 助手"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.yuketang.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}